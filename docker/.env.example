NGINX_PORT=80

# Nginx 使用固定容器 IP，Webman 只信任这个代理的转发头。
# 若与现有网络冲突，同时修改子网、动态地址池和固定 IP；固定 IP 必须在子网内、动态地址池外。
DOCKER_SUBNET=172.30.84.0/24
DOCKER_IP_RANGE=172.30.84.128/25
NGINX_INTERNAL_IP=172.30.84.2

# webman 容器以谁的身份跑。默认 root：它把宿主机的 server/ 绑进容器，
# UID 对不上就写不了 .env 与 runtime。Linux 上建议设成 $(id -u):$(id -g)。
DOCKER_USER=root

# MySQL 与 Redis 默认只绑回环（127.0.0.1）。确需从别的机器连再改这两个，
# 改之前先想清楚这台机器暴露在什么网络里。
MYSQL_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
MYSQL_PORT=3306
REDIS_PORT=6379

# 下面三个没有默认值，不填 compose 直接拒绝启动。各自生成一串随机值：
#   docker run --rm php:8.4-cli-bookworm php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
MYSQL_DATABASE=ydadmin
MYSQL_USER=ydadmin
