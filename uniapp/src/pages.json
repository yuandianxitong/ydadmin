      "pages": [
        { "path": "pages/profile", "style": { "navigationBarTitleText": "个人中心" } },
        { "path": "pages/edit-profile", "style": { "navigationBarTitleText": "编辑资料" } },
        { "path": "pages/change-password", "style": { "navigationBarTitleText": "修改密码" } },
