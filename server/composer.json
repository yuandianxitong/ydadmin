{
  "name": "yuandianxitong/ydadmin",
  "type": "project",
  "keywords": ["admin", "rbac", "webman", "workerman"],
  "homepage": "https://github.com/yuandianxitong/ydadmin",
  "license": "MIT",
  "description": "元点Admin：基于 webman 的通用后台管理系统",
  "authors": [
    {
      "name": "元点系统",
      "homepage": "https://github.com/yuandianxitong"
    }
  ],
  "support": {
    "issues": "https://github.com/yuandianxitong/ydadmin/issues",
    "source": "https://github.com/yuandianxitong/ydadmin"
  },
  "require": {
    "php": "^8.4",
    "workerman/webman-framework": "^2.2",
    "monolog/monolog": "^2.0",
    "webman/console": "^2.2",
    "webman/database": "^2.1",
    "webman/cache": "^2.1",
    "webman/redis": "^2.1",
    "illuminate/pagination": "^13.31",
    "illuminate/events": "^13.31",
    "illuminate/validation": "^13.31",
    "illuminate/translation": "^13.31",
    "php-di/php-di": "^7.1",
    "firebase/php-jwt": "^7.1",
    "vlucas/phpdotenv": "^5.7",
    "guzzlehttp/guzzle": "^7.9"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "core\\": "./core"
    },
    "files": [
      "core/support/lang.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "./tests"
    }
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ],
    "post-create-project-cmd": [
      "support\\Setup::run"
    ],
    "setup-webman": [
      "support\\Setup::run"
    ],
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:redline": "phpunit --testsuite redline",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "lint:fix": "php-cs-fixer fix",
    "analyse": "phpstan analyse --memory-limit=1G",
    "check:context": "bash scripts/check-context-discipline.sh",
    "contract": "php scripts/admin-contract-check.php"
  },
  "config": {
    "process-timeout": 0
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2"
  }
}
