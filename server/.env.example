# ============================================================
# 元点Admin 环境配置示例
# 复制此文件为 .env 并根据实际环境修改
# ============================================================

APP_DEBUG = true
APP_TRACE = false
# 生产环境请生成32+字符的随机字符串
APP_KEY = change-me-app-key
# JWT签名密钥
JWT_SECRET = change-me-jwt-secret

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[LANG]
default_lang = zh-cn

[DB]
TYPE = mysql
HOST = 127.0.0.1
PORT = 3306
NAME = dev007
USER = root
PASS = root
CHARSET = utf8mb4
# PREFIX =

[CACHE]
# 可选值: file, redis (Docker环境推荐使用 redis)
DRIVER = file
EXPIRE = 3600
PREFIX = think

[SESSION]
TYPE = file
EXPIRE = 1800
PREFIX = think

[REDIS]
# Docker环境使用 HOST = redis (容器服务名)
HOST = 127.0.0.1
PORT = 6379
PASSWORD =
SELECT = 0
TIMEOUT = 0
EXPIRE = 3600
PERSISTENT = false
PREFIX = think

[QUEUE]
CONNECTOR = sync
