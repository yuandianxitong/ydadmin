# 本地开发可改为 true；生产环境必须为 false（开启会在错误响应中暴露异常信息与文件路径）
APP_DEBUG = false

DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_NAME = dev007_ydadmin
DB_USER = root
DB_PASSWORD =
DB_PREFIX =

REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD =
REDIS_DB = 0

# 队列驱动：redis（生产，需要 php start.php start 拉起的 queue 进程常驻）；sync 只供测试使用
QUEUE_DRIVER = redis
# 队列消费进程数
QUEUE_PROCESS_COUNT = 2
# 定时任务消费进程数
QUEUE_SLOW_PROCESS_COUNT = 1
# 消息与文件任务分别隔离，避免长任务阻塞消息发送
QUEUE_MESSAGE_PROCESS_COUNT = 2
QUEUE_TASK_PROCESS_COUNT = 1

# 可靠投递租约；长文件任务每批续约
DELIVERY_LEASE_SECONDS = 3600
TASK_MAX_ROWS = 100000
TASK_MAX_FILE_MB = 50
# 默认 runtime/private-tasks；多机部署设为 HTTP 与任务进程共用的非公开持久卷
# TASK_STORAGE_PATH = /data/private-tasks
REQUIRE_WORKERS_READY = true
SLOW_REQUEST_MS = 1000
SLOW_QUERY_MS = 200

# 管理员 WebSocket 实时通道监听地址（nginx 把 /ws 反向代理到这里）与进程数
WS_LISTEN = websocket://0.0.0.0:8001
WS_PROCESS_COUNT = 1

# 两个 scope 必须不同，且各 ≥ 32 字节：php -r "echo bin2hex(random_bytes(32));"
JWT_ADMIN_SECRET =
JWT_USER_SECRET =

# 允许跨域访问 API 的前端来源，逗号分隔，如 https://admin.example.com；留空表示只允许同域
CORS_ALLOWED_ORIGINS =

# 反向代理（如 nginx）的 IP，逗号分隔；只有来自这些地址的请求才读取 X-Forwarded-For（取最右侧的非代理地址）。直连部署留空
TRUSTED_PROXIES =

SERVER_LISTEN = http://0.0.0.0:8000
