{
    "schema_version": 1,
    "id": "user.user",
    "module": "user",
    "model": "User",
    "origin": "builtin",
    "table": "users",
    "title": "会员",
    "primary_key": "id",
    "permission_prefix": "user",
    "permissions": [
        "user.list",
        "user.detail",
        "user.adjust-balance",
        "user.adjust-points",
        "user.status",
        "user.balance-logs",
        "user.import",
        "user.points-logs"
    ],
    "routes": [
        {
            "method": "GET",
            "path": "/adminapi/user/list",
            "action": "index",
            "permission": "user.list"
        },
        {
            "method": "GET",
            "path": "/adminapi/user/detail/{id:\\d+}",
            "action": "detail",
            "permission": "user.detail"
        },
        {
            "method": "POST",
            "path": "/adminapi/user/adjust-balance",
            "action": "adjustBalance",
            "permission": "user.adjust-balance"
        },
        {
            "method": "POST",
            "path": "/adminapi/user/adjust-points",
            "action": "adjustPoints",
            "permission": "user.adjust-points"
        },
        {
            "method": "PUT",
            "path": "/adminapi/user/{id:\\d+}/status",
            "action": "updateStatus",
            "permission": "user.status"
        },
        {
            "method": "GET",
            "path": "/adminapi/user/balance-logs",
            "action": "balanceLogs",
            "permission": "user.balance-logs"
        },
        {
            "method": "POST",
            "path": "/adminapi/user/import",
            "action": "import",
            "permission": "user.import"
        },
        {
            "method": "GET",
            "path": "/adminapi/user/import-template",
            "action": "importTemplate",
            "permission": "user.import"
        },
        {
            "method": "GET",
            "path": "/adminapi/user/points-logs",
            "action": "pointsLogs",
            "permission": "user.points-logs"
        }
    ],
    "capabilities": {
        "soft_deletes": true,
        "status": true,
        "data_scope": false
    },
    "fields": [],
    "artifacts": {
        "controller": "server/app/adminapi/controller/user/UserManageController.php",
        "model": "server/app/model/user/User.php",
        "repository": "server/app/repository/user/UserRepository.php",
        "service": "server/app/service/user/UserService.php",
        "descriptor": "server/modules/user/user.json"
    }
}
